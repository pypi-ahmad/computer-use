# Copy to .env. Never commit the populated file.

# Executable direct routes (set at least one)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=                         # Google alias

# Catalogued cloud routes (execution bridge unavailable in v2.0.0)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=                   # optional fallback to Entra
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AWS_PROFILE=
# AWS_REGION=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Backend and durable state
HOST=127.0.0.1
PORT=8100
CUA_V2_DB_PATH=data/computer-use-v2.sqlite3
CUA_FRAME_DIR=data/frames
# CUA_FRONTEND_DIST=frontend/dist

# Required sandbox secrets. Generate unique random values.
AGENT_SERVICE_TOKEN=
VNC_PASSWORD=
CONTAINER_NAME=cua-environment
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=9222
SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
MAX_STEPS=50
STEP_TIMEOUT=30.0

# External binding is disabled unless both values are intentionally set.
# CUA_ALLOW_PUBLIC_BIND=1
# CUA_WS_TOKEN=

LOG_FORMAT=console
LOG_LEVEL=INFO
DEBUG=0
