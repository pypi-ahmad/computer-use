# Copy to .env. Never commit the populated file.

# Executable direct routes (set at least one)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Prefer a process-level GOOGLE_API_KEY (user/system env). dotenv does
# not override it. Leave these commented when the env var is already set.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=                         # Google alias

# Backend and durable state
HOST=127.0.0.1
PORT=8100
CUA_V2_DB_PATH=data/computer-use-v2.sqlite3
CUA_V2_FRAME_PATH=data/audit-frames
# CUA_FRONTEND_DIST=frontend/dist

# Required sandbox secret. Generate a unique random value.
AGENT_SERVICE_TOKEN=
# VNC_PASSWORD is ignored. x11vnc starts with -nopw; noVNC has no password.
CONTAINER_NAME=cua-environment
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=9222
SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
MAX_STEPS=50
STEP_TIMEOUT=30.0

# External binding is disabled unless both values are intentionally set.
# CUA_ALLOW_PUBLIC_BIND=1
# Optional: override Fetch MCP used when Provider web search planning is on.
# CUA_MCP_FETCH_CMD=uvx mcp-server-fetch

# Optional shared workbench token for REST, WebSocket, and noVNC.
# CUA_API_TOKEN=
# Deprecated compatibility fallback: CUA_WS_TOKEN=

# Google OAuth (optional; API-key login works without these).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=
# GOOGLE_CLOUD_PROJECT=                  # optional quota project
# CUA_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8100/api/v2/credential-sessions/google/oauth/callback

LOG_FORMAT=console
LOG_LEVEL=INFO
DEBUG=0

# Advanced tuning (optional — defaults are good for most setups)
# Container startup: increase TIMEOUT on slow hosts or Docker images.
# CUA_CONTAINER_READY_TIMEOUT=30.0     # seconds to wait for /health after docker run
# CUA_CONTAINER_READY_POLL_BASE=0.5    # initial health-check poll interval (doubles each attempt)
# CUA_CONTAINER_READY_POLL_CAP=3.0     # max health-check poll interval
# WebSocket screenshot stream: lower INTERVAL for smoother live view; raise on slow networks.
# CUA_WS_SCREENSHOT_INTERVAL=1.5       # seconds between periodic screenshots to WS clients
# CUA_WS_SCREENSHOT_SUSPEND_WHEN_IDLE=true  # pause capture when no WS subscribers
# CUA_WS_SCREENSHOT_BACKOFF_CAP=30.0   # max backoff (s) on repeated capture failures
# Live preview encoding: raise MAX_EDGE / lower quality on bandwidth-constrained setups.
# CUA_PREVIEW_MAX_EDGE=960             # downscale live preview to this max edge (px)
# CUA_PREVIEW_JPEG_QUALITY=60          # JPEG quality for live preview fan-out (10–95)
# Action settle delays: raise if the sandbox UI is slow to repaint after actions.
# CUA_UI_SETTLE_DELAY=0.3              # post-action settle (s)
# CUA_UI_SETTLE_DELAY_MIN=0.05         # min settle for fast actions (mouse-move/hover)
# CUA_UI_SETTLE_DELAY_NAV=0.6          # settle after navigate / type actions
# CUA_SCREENSHOT_SETTLE_DELAY=0.12     # post-capture settle before delivering screenshot
# CUA_POST_ACTION_SCREENSHOT_DELAY=5.0 # delay (s) before the post-action screenshot
